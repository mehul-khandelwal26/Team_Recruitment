# Team Recruitment Automation Tool - Frontend Environment Configuration
# Copy this file to .env.local for local development, or configure in your deployment platform.

# Backend API Base URL (FastAPI server endpoint).
# - Local development: http://localhost:8000
# - Production with same-domain / reverse proxy (Nginx, Caddy): leave empty ("")
# - Production with separate frontend/backend domains (Vercel, Render, Railway): set to your deployed backend URL (e.g. https://api.yourdomain.com)
VITE_API_BASE_URL=http://localhost:8000
