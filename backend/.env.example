# =============================================================================
# Team Recruitment Automation Tool - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# =============================================================================

# Application Settings
APP_ENV=development
APP_DEBUG=true

# Server Settings
APP_HOST=0.0.0.0
APP_PORT=8000

# Database Settings (for future integration)
DATABASE_URL=postgresql://user:password@localhost:5432/team_recruitment_db

# CORS Settings
CORS_ORIGINS=http://localhost:5173

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10

# GitHub Integration (optional personal access token to raise rate limit from 60 to 5000 req/hr)
# GITHUB_TOKEN=ghp_your_token_here
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_REQUEST_TIMEOUT=10.0
