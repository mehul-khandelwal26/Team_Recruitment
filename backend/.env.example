# =============================================================================
# Team Recruitment Automation Tool - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# =============================================================================

# Application Settings
APP_ENV=development
APP_DEBUG=true

# Server Settings
APP_HOST=0.0.0.0
APP_PORT=8000

# Storage Backend Settings ("memory" or "postgres"; in production, must be "postgres")
STORAGE_BACKEND=memory

# Database Settings
# Direct connection URL (used for app direct mode and Alembic migrations)
DATABASE_URL=postgresql://user:password@localhost:5432/team_recruitment_db

# Optional pooled connection URL (used for app runtime if connection pooler is configured)
# DATABASE_URL_POOLED=postgresql://user:password@localhost:6543/team_recruitment_db

# Isolated test database URL (required to run database integration tests; never points to production/dev DB)
# TEST_DATABASE_URL=postgresql://test_user:test_password@localhost:5432/team_recruitment_test_db

# CORS Settings (comma-separated origins allowed to access the API; do not use wildcard '*' with credentials)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend-domain.com

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10

# GitHub Integration (optional personal access token to raise rate limit from 60 to 5000 req/hr)
# GITHUB_TOKEN=ghp_your_token_here
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_REQUEST_TIMEOUT=10.0

# Authentication & Google OAuth
AUTH_ENABLED=true
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Optional email / domain whitelist (comma-separated; leave empty to allow any authenticated Google user)
# ALLOWED_EMAILS=organizer1@gmail.com,lead@org.edu
# ALLOWED_EMAIL_DOMAINS=myorganization.com

