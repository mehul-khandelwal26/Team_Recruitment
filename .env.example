# =============================================================================
# Team Recruitment Automation Tool - Global Deployment Environment Configuration
# =============================================================================
# Copy this file to .env for Docker Compose deployment, or configure these variables
# in your target deployment platform (Render, Railway, Fly.io, AWS ECS, GCP Cloud Run).
# =============================================================================

# --- Database Settings (PostgreSQL 15+) ---
POSTGRES_USER=recruitment_admin
POSTGRES_PASSWORD=replace_with_a_secure_database_password
POSTGRES_DB=team_recruitment_db
# In production, specify your hosted PostgreSQL connection URL (Neon, Supabase, AWS RDS, Render Postgres)
# DATABASE_URL=postgresql://user:password@hostname:5432/team_recruitment_db?sslmode=require

# --- Backend Application Settings ---
APP_ENV=production
APP_PORT=8000
STORAGE_BACKEND=postgres

# --- Security & Authentication ---
AUTH_ENABLED=true
JWT_SECRET_KEY=replace_with_a_secure_64_character_random_hex_string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Google OAuth Credentials (Optional / Leave empty for Dev Mock Login) ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# ALLOWED_EMAILS=organizer1@gmail.com,lead@university.edu
# ALLOWED_EMAIL_DOMAINS=university.edu

# --- GitHub Integration (Optional - increases API rate limit from 60 to 5000 req/hr) ---
# GITHUB_TOKEN=ghp_your_personal_access_token_here

# --- CORS & Domain Mapping ---
# Comma-separated list of origins permitted to call the backend API
CORS_ORIGINS=http://localhost:5173,https://your-recruitment-app.vercel.app

# --- Frontend Build Configuration ---
# Set to your hosted backend API URL if frontend & backend are deployed on separate domains:
# VITE_API_BASE_URL=https://recruitment-api.onrender.com
VITE_API_BASE_URL=http://localhost:8000
